// Sala de Producción · Jakiens — modelo de datos
// Ver REQUISITOS.md sección 4 para el diseño funcional detrás de este esquema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Equipo interno de Jakiens ----------
// Ver REQUISITOS.md sección 9 para el porqué de estos tres niveles.

enum StaffTier {
  FULL           // acceso total: Javier, Aina, Chiara, Mikko, Aitor, Maca
  LOGISTICS      // sin contabilidad: Pablo, Carmen
  POSTPRODUCTION // montaje/edición: Malo, Miquel, Lungo
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  tier         StaffTier
  /**
   * Acceso al presupuesto de VENTA — lo que se cotiza al cliente.
   *
   * Va aparte del `tier` a propósito. El nivel decide qué fases se ven; esto
   * decide quién ve la cifra que se le pasa al cliente, y las dos cosas no se
   * solapan: Carmen es nivel LOGISTICS y sí ve costes para negociar tarifas,
   * pero no ve lo que cobramos. Meterlo en el tier obligaría a inventar un
   * nivel nuevo por cada combinación.
   */
  accesoPresupuestoVenta Boolean @default(false)
  createdAt    DateTime  @default(now())

  hitos                    Hito[]
  asignaciones             AsignacionEtapa[]
  presupuestosActualizados PresupuestoVenta[]
}

// ---------- Proyecto ----------

/**
 * Etapa de negocio: dónde está el proyecto en la vida de la compañía.
 *
 * NO confundir con las siete fases operativas de `PhaseState` (equipo, prepro,
 * materiales, altas, rodaje, postpro, cierre), que son el desglose del trabajo
 * del producer a partir del GO. La etapa es el eje que ve toda la compañía en el
 * gestor de proyectos; la fase es el eje que opera el producer dentro de la sala
 * de producción. Una etapa contiene varias fases, no al revés.
 *
 * VENTA es la novedad: hasta ahora un proyecto solo se daba de alta cuando ya se
 * había ganado, así que la mitad del trabajo de la compañía —la que se hace para
 * ganarlo— no existía en ninguna herramienta.
 */
enum Etapa {
  VENTA
  PREPRODUCCION
  RODAJE
  POSTPRODUCCION
  CIERRE
}

/**
 * Si el proyecto sigue vivo, y por qué no lo está si no lo está.
 *
 * Antes eran dos valores de texto (`activo` | `cerrado`), que bastaban cuando un
 * proyecto solo se creaba tras ganarlo. Con la etapa de venta hacen falta los
 * finales que no son un cierre: PERDIDO y PAUSADO.
 *
 * PERDIDO no borra ni esconde nada: el proyecto se archiva y se puede consultar.
 * Lo que se trabajó para intentar ganarlo es tan real como lo que se produce, y
 * saber cuánto se presentó frente a cuánto se ganó es información de negocio.
 */
enum EstadoProyecto {
  OPORTUNIDAD // en venta, todavía sin decidir
  ACTIVO // ganado y en marcha
  PERDIDO // no se ganó — se archiva y se consulta
  PAUSADO // congelado por el cliente, puede volver
  CERRADO // entregado y cerrado económicamente
}

model Project {
  id              String   @id @default(cuid())
  code            String   @unique
  client          String
  name            String
  director        String
  agencia          String
  shootLabel      String
  location        String
  format          String
  etapa           Etapa          @default(PREPRODUCCION)
  estado          EstadoProyecto @default(ACTIVO)
  // Marca que produce. Jakiens y Ricorico comparten fisco, equipo y directorio de
  // colaboradores: lo que cambia es la escala del proyecto, las plantillas y el
  // discurso comercial, no los datos. Por eso es un campo, no una base separada.
  brand           String   @default("JAKIENS") // JAKIENS | RICORICO
  // Fechas clave del kickoff — texto libre (igual que el resto de fechas de la app), no Date real.
  preproInicio        String?
  preproFin           String?
  rodajeInicio        String?
  rodajeFin           String?
  entregaMaterial     String?
  primeraEntregaMontaje String?
  // Identidad visual de la vista de cliente. El logo de Jakiens/Ricorico sale de
  // `brand` y es fijo; estos tres cambian en cada proyecto.
  portadaUrl      String? // imagen de portada: frame del animatic, moodboard, foto de loca...
  logoClienteUrl  String?
  logoAgenciaUrl  String?
  driveFolderUrl  String? // carpeta de Drive con todo el material de postproducción
  /**
   * Canal de Slack del proyecto.
   *
   * `slackChannelId` lo rellena sola la app al dar el GO, si hay
   * `SLACK_BOT_TOKEN`. Cuando existe, los avisos van por la API con el token del
   * bot y ya no hace falta pegar ningún webhook a mano.
   *
   * `slackWebhookUrl` se conserva para los proyectos anteriores, que tienen su
   * webhook puesto y seguirían funcionando igual.
   */
  slackChannelId   String? // ej. "C09ABCDEF"
  slackChannelName String? // ej. "proj-eg-2611", para poder enlazarlo
  slackWebhookUrl String? // webhook del canal de Slack del proyecto, para notificaciones
  createdAt       DateTime @default(now())

  phaseStates      PhaseState[]
  hitos            Hito[]
  asignaciones     AsignacionEtapa[]
  presupuestoVenta PresupuestoVenta?
  members          ProjectMember[]
  materials        Material[]
  callSheetDays    CallSheetDay[]
  clientAccesses   ClientAccess[]
  necesidades      Necesidad[]
  puestosPrevistos PuestoPrevisto[]
  expenses         Expense[]
  materialRequests MaterialRequest[]
}

model PhaseState {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String // equipo | prepro | materiales | altas | rodaje | cierre
  state     String // done | live | next

  @@unique([projectId, key])
}

// ---------- Hitos: las fechas que ve toda la compañía ----------

/**
 * Qué clase de fecha es. Determina cómo se pinta en el calendario y qué avisos
 * genera: un RODAJE bloquea la jornada de todo el equipo, una ENTREGA_CLIENTE
 * solo compromete a quien la trabaja.
 */
enum TipoHito {
  ENTREGA_PROPUESTA // venta: cuándo hay que presentar
  PPM // pre-production meeting
  RODAJE
  ENTREGA_MATERIAL
  ENTREGA_MONTAJE
  ENTREGA_CLIENTE
  CIERRE_ECONOMICO
  OTRO
}

/** Cuánto duele fallar esta fecha, con independencia de lo cerca que esté. */
enum Criticidad {
  NORMAL
  ALTA
  CRITICA
}

/**
 * Una fecha señalada de un proyecto.
 *
 * Es la ÚNICA fuente de verdad del calendario, y la única parte del modelo con
 * fechas de verdad. El resto de la app guarda las fechas como texto libre
 * ("14 JUL", "24–25 JUL 2026") porque se escriben a mano y así nadie pelea con
 * formatos; la contrapartida es que sobre ese texto no se puede ordenar, ni
 * filtrar por trimestre, ni detectar que dos cosas caen el mismo día. Un
 * calendario trimestral necesita `DateTime`.
 *
 * Los campos de texto del proyecto NO desaparecen: se siguen mostrando donde ya
 * se mostraban, como etiqueta legible. Lo que hace el hito es guardar además la
 * fecha real detrás.
 *
 * `fecha` y `fechaFin` son fechas de calendario, no instantes: un rodaje es el
 * día 24, no las 00:00 del 24 en un huso concreto. De ahí `@db.Date`.
 */
model Hito {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  etapa     Etapa
  tipo      TipoHito @default(OTRO)
  titulo    String
  /// Día del hito. Para un rango (rodaje de varias jornadas, ventana de
  /// preproducción) es el primer día y `fechaFin` el último.
  fecha     DateTime  @db.Date
  fechaFin  DateTime? @db.Date
  criticidad Criticidad @default(NORMAL)
  notas     String?

  /// Quién responde de esta fecha. Es del equipo interno: los hitos los mueve
  /// quien lidera la etapa, no el colaborador que ejecuta.
  responsableId String?
  responsable   StaffUser? @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  /**
   * De dónde sale el hito. Los derivados no se editan a mano: se regeneran
   * desde su origen, porque si el producer cambia la fecha de una jornada en la
   * orden de rodaje, el calendario tiene que seguirla sin que nadie lo recuerde.
   *
   * manual    — lo creó una persona en el gestor
   * callsheet — proyectado desde CallSheetDay.fechaISO
   * proyecto  — proyectado desde las fechas de texto del alta de proyecto
   */
  origen   String  @default("manual")
  origenId String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // El calendario maestro consulta por rango de fechas sobre todos los
  // proyectos a la vez; la ficha de proyecto, por proyecto.
  @@index([fecha])
  @@index([projectId, fecha])
  // Evita duplicar un hito derivado cada vez que se regenera su origen. En
  // Postgres varios NULL no colisionan, así que los manuales quedan libres.
  @@unique([origen, origenId])
}

// ---------- Quién trabaja cada etapa ----------

/**
 * Una persona del equipo interno asignada a un proyecto EN UNA ETAPA CONCRETA.
 *
 * El equipo cambia según la etapa y por eso la asignación cuelga de las dos
 * cosas: en venta trabajan creativos y montadores preparando la presentación,
 * en preproducción entra un producer que antes no estaba, y en postpo vuelven
 * los de montaje. Guardar "quién trabaja en este proyecto" a secas perdería
 * justo la información que hace falta para saber quién tiene qué encima esta
 * semana.
 *
 * Es para el equipo interno (`StaffUser`), no para colaboradores externos: esos
 * ya viven en `ProjectMember`, con su tarifa, sus jornadas y su alta laboral.
 * Son dos cosas distintas —una es reparto de trabajo, la otra es contratación—
 * y unificarlas obligaría a inventar tarifas para gente que va en nómina.
 *
 * `responsable` marca al lead de la etapa: quien nutre la información y a quien
 * se le pregunta. Debería haber uno por etapa, pero no se fuerza en el modelo:
 * hay semanas en que un proyecto cambia de manos y tener cero o dos durante un
 * par de días es la realidad, no un error que deba bloquear el guardado.
 */
model AsignacionEtapa {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffUserId String
  staff       StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  etapa       Etapa
  /// Qué hace en esta etapa: "Producer", "Montaje", "Cotización"... Texto libre
  /// porque el reparto real no cabe en una lista cerrada.
  rol         String?
  responsable Boolean   @default(false)
  creadoEn    DateTime  @default(now())

  @@unique([projectId, staffUserId, etapa])
  // "Qué me toca a mí" consulta por persona y etapa.
  @@index([staffUserId, etapa])
}

// ---------- Presupuesto de venta ----------

/**
 * Lo que se cotiza al cliente.
 *
 * Tabla aparte y no un campo de `Project` porque su visibilidad es distinta de
 * la del resto del proyecto: la ve un grupo concreto de personas
 * (`StaffUser.accesoPresupuestoVenta`) y no todo el que puede abrir la ficha. Si
 * fuese una columna de `Project`, cualquier consulta que devuelva el proyecto la
 * arrastraría, y bastaría un olvido en una pantalla nueva para filtrarla.
 *
 * No confundir con el presupuesto de COSTE, que es lo que pagamos y ya vive
 * repartido en `ProjectMember.rate`, `dias` y `presupuestoGasto`.
 */
model PresupuestoVenta {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Importe cotizado en euros enteros, como el resto de cifras de la app.
  importe   Int?
  estado    String  @default("borrador") // borrador | enviado | aprobado | rechazado
  notas     String? @db.Text
  enviadoEn DateTime?

  actualizadoEn    DateTime   @updatedAt
  actualizadoPorId String?
  actualizadoPor   StaffUser? @relation(fields: [actualizadoPorId], references: [id], onDelete: SetNull)
}

// ---------- Personas ----------

model Person {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  initials  String
  // Datos fiscales — viven en la persona, no en cada alta de proyecto, para no volver
  // a pedirlos cada vez que un colaborador repite en un proyecto nuevo.
  dni       String?
  naf       String?
  domicilio String?
  iban      String?
  irpf      String?
  sexo      String? // "M" | "F" — lo pide la hoja de alta de la gestoría
  fechaNacimiento String? // texto libre, igual que el resto de fechas de la app
  categoria String? // categoría/función habitual (la del Índice); el rol real por proyecto vive en ProjectMember
  okTicketId String? // para cuando lleguen las credenciales de la API de OK Ticket
  createdAt DateTime @default(now())

  memberships ProjectMember[]
}

model ProjectMember {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  role             String // perfil: Realizador, DOP, Food Stylist...
  rate             Int // honorarios netos por jornada
  dias             Int
  presupuestoGasto Int @default(0) // presupuesto de gasto de materiales de la partida, aparte de los honorarios
  confirmed     Boolean  @default(false)
  requiereAlta  Boolean  @default(false)
  /// Gente de casa (Jakiens/Ricorico) frente a colaboradores y subcontratados.
  /// Al equipo propio no se le imputa coste por proyecto: va en nómina, y
  /// meterlo en el presupuesto del rodaje falsea lo que cuesta producirlo.
  esEquipoCore  Boolean  @default(false)
  // Determina en qué hoja del Excel de la gestoría entra: EQUIPO TÉCNICO (crew)
  // o EQUIPO ARTÍSTICO (cast). Son dos tablas con columnas distintas.
  tipoEquipo    String   @default("tecnico") // tecnico | artistico
  permisos      String[] // ["Briefing","Materiales","Rodaje","Cierre"]
  callTime      String?
  brief         String?  @db.Text
  /// Restricciones alimentarias para el catering.
  ///
  /// CATEGORÍA ESPECIAL (art. 9 RGPD): son datos de salud. Por eso se piden por
  /// proyecto y no se guardan de forma permanente en Person, van cifradas, y el
  /// cliente solo las ve agregadas y sin nombres ("2 sin gluten, 1 vegano").
  /// Producción sí las ve con nombre: alguien tiene que saber quién no puede
  /// comer qué.
  restriccionesAlimentarias String?

  accessTokens  AccessToken[]
  materialTargets MaterialTarget[]
  altaLaboral   AltaLaboral?
  invoice       Invoice?
  callTimes     CallTime[]
  necesidades   Necesidad[]

  @@unique([projectId, personId])
}

model AccessToken {
  id              String        @id @default(cuid())
  projectMemberId String
  projectMember   ProjectMember @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)
  token           String        @unique
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
}

/**
 * Acceso de cliente y agencia a la orden de rodaje.
 *
 * Son dos enlaces distintos aunque enseñen lo mismo: permite revocar el de la
 * agencia sin cortarle el acceso al cliente, y saber cuál de los dos se ha
 * abierto. No hay login: es un enlace largo con caducidad, como el de
 * colaborador, porque pedirle una cuenta al cliente sería una barrera absurda
 * para un documento que solo sirve unos días.
 */
model ClientAccess {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token      String   @unique
  tipo       String   // cliente | agencia
  etiqueta   String?  // "Marta, de McCann" — para saber a quién se le dio
  expiresAt  DateTime
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())

  @@index([projectId])
}

// ---------- Materiales ----------

model Material {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  ext        String
  sizeLabel  String?
  version    String?
  direction  String // "in" (descarga colaborador) | "out" (sube colaborador)
  /// Un material puede ser un archivo subido o un enlace a la nube. Buena parte
  /// del trabajo vive en Drive o Dropbox en colaborativo, y subir una copia
  /// significaría trabajar sobre una versión congelada mientras la buena sigue
  /// cambiando fuera.
  linkUrl    String?
  // Los archivos nuevos van a Vercel Blob y aquí queda su URL. `fileData` se
  // conserva para los que se subieron antes, cuando el contenido vivía en la
  // propia base de datos: al descargar se mira primero la URL y, si no hay,
  // los bytes. Así no hay que migrar nada a mano.
  fileUrl    String?
  fileData   Bytes?
  fileName   String? // nombre de archivo original, para el Content-Disposition al descargar
  uploadedAt DateTime @default(now())

  targets MaterialTarget[]
}

model MaterialTarget {
  id              String        @id @default(cuid())
  materialId      String
  material        Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  projectMemberId String
  projectMember   ProjectMember @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)

  @@unique([materialId, projectMemberId])
}

// ---------- Altas laborales (fase 4 — pendiente de plantilla real) ----------

model AltaLaboral {
  id               String        @id @default(cuid())
  projectMemberId  String        @unique
  projectMember    ProjectMember @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)
  // Los datos fiscales (DNI, NAF, IBAN, domicilio, IRPF) viven en Person — aquí solo
  // lo específico de este alta en concreto.
  fechaAlta        String?
  fechaBaja        String?
  // Importes que la gestoría necesita y que no salen del directorio: se pactan
  // por proyecto. `salarioSesion` solo aplica a equipo artístico (cast).
  importeBruto     Int?
  salarioSesion    Int?
  estado           String        @default("pendiente") // pendiente | recibida
  sentToGestoriaAt DateTime?
}

// ---------- Necesidades y plantilla de equipo ----------

/**
 * Necesidad de un departamento para este proyecto.
 *
 * Cuelga del DEPARTAMENTO y no de la persona: "8 dobles de producto" es de
 * arte, y lo sigue siendo si cambia el jefe de arte a mitad de preproducción.
 * Colgarla de la persona haría perder la información en cada cambio de equipo.
 *
 * `responsableId` marca quién la lleva. Es quien la ve en su acceso: los jefes
 * de cada vertical, no los ayudantes.
 */
model Necesidad {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  departamento String         // ARTE | VESTUARIO | CASTING | OPTICAS | MATERIALES | OTROS
  concepto     String         // "Óptica macro", "Dobles de producto"
  detalle      String?        // "8 uds por hero", "reservada en Camaleón"
  estado       String         @default("pendiente") // pendiente | confirmada | descartada
  responsableId String?
  responsable  ProjectMember? @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  orden        Int            @default(0)

  @@index([projectId, departamento])
}

/**
 * Puesto previsto en el presupuesto aprobado: "2 eléctricos", "1 DOP".
 *
 * Sirve para avisar de que falta gente por cerrar, no para bloquear nada. El
 * producer muchas veces no tiene el nombre hasta el final, así que
 * `confirmadoManualmente` permite silenciar el aviso de una línea concreta sin
 * tener que inventarse un nombre para quitarse el rojo de encima.
 */
model PuestoPrevisto {
  id                    String  @id @default(cuid())
  projectId             String
  project               Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rol                   String  // se compara con ProjectMember.role
  cantidad              Int     @default(1)
  confirmadoManualmente Boolean @default(false)
  nota                  String?
  orden                 Int     @default(0)

  @@index([projectId])
}

// ---------- Rodaje (fase 5) ----------

model CallSheetDay {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fecha         String
  /// Fecha real de la jornada. El resto de la app usa fechas en texto libre,
  /// pero el bloque "ahora mismo" de la vista de cliente y el archivo de
  /// calendario necesitan una fecha de verdad: sin ella no se puede saber si
  /// hoy es el día de rodaje ni generar un evento.
  fechaISO      DateTime?
  /// OBSOLETO: sustituido por el modelo Localizacion, que admite varias por
  /// jornada con dirección, parking y accesos. Se conserva solo para no perder
  /// datos de jornadas anteriores; nada lo escribe ya.
  localizacion  String?
  primeraHora   String?
  amanecer      String?
  ocaso         String?
  meteo         String?
  puntoEncuentro String?
  contactoSet    String? // quién de producción está localizable en set ese día
  contactoSetTel String? // el ÚNICO teléfono que ven colaboradores, cliente y agencia
  orden         Int      @default(0) // para ordenar las jornadas sin depender del texto de la fecha

  // Hospital más cercano. Va en la orden de rodaje de cualquier producción seria
  // y forma parte de la prevención de riesgos: el día que alguien se hace daño,
  // nadie debería estar buscándolo en el móvil.
  hospitalNombre    String?
  hospitalDireccion String?
  hospitalTelefono  String?
  hospitalMapsUrl   String?

  // Catering. Los menús se cuentan aquí; las restricciones alimentarias viven
  // en ProjectMember porque son de cada persona.
  cateringDesayuno String?
  cateringComida   String?
  cateringNotas    String?

  // Hora a la que a producción le interesa que aparezcan cliente y agencia.
  // No es el call del equipo: es cuando ya hay algo que enseñar.
  llegadaCliente String?

  scheduleItems ScheduleItem[]
  callTimes     CallTime[]
  localizaciones Localizacion[]
  traslados      Traslado[]
}

/**
 * Localización de una jornada. Son varias por día en cuanto hay un traslado, así
 * que no puede ser un campo de texto en la jornada.
 */
model Localizacion {
  id             String       @id @default(cuid())
  callSheetDayId String
  callSheetDay   CallSheetDay @relation(fields: [callSheetDayId], references: [id], onDelete: Cascade)
  nombre         String       // "Nave de Paterna", "Terraza del hotel"
  direccion      String?
  mapsUrl        String?
  parking        String?
  accesos        String?      // por qué puerta se entra, códigos, a quién preguntar
  notas          String?
  orden          Int          @default(0)
}

/**
 * Orden de traslados. `ocupantes` es texto libre a propósito: producción escribe
 * "equipo de arte + Clara" y forzar una lista de personas seleccionables haría
 * el formulario más lento que el WhatsApp que viene a sustituir.
 */
model Traslado {
  id             String       @id @default(cuid())
  callSheetDayId String
  callSheetDay   CallSheetDay @relation(fields: [callSheetDayId], references: [id], onDelete: Cascade)
  hora           String
  origen         String
  destino        String
  vehiculo       String?
  conductor      String?
  ocupantes      String?
  notas          String?
  orden          Int          @default(0)
}

/**
 * Hora de convocatoria de una persona en una jornada concreta.
 *
 * `ProjectMember.callTime` sigue existiendo como hora por defecto del proyecto,
 * pero en un rodaje de varias jornadas cada día tiene sus horas: el equipo de
 * arte entra antes que el de cámara, y no el mismo día que el cast. Sin esto la
 * orden de rodaje solo servía para rodajes de un día.
 */
model CallTime {
  id              String        @id @default(cuid())
  callSheetDayId  String
  callSheetDay    CallSheetDay  @relation(fields: [callSheetDayId], references: [id], onDelete: Cascade)
  projectMemberId String
  projectMember   ProjectMember @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)
  hora            String

  @@unique([callSheetDayId, projectMemberId])
}

model ScheduleItem {
  id             String       @id @default(cuid())
  callSheetDayId String
  callSheetDay   CallSheetDay @relation(fields: [callSheetDayId], references: [id], onDelete: Cascade)
  hora           String
  descripcion    String
}

// ---------- Postproducción (fase 6) ----------

model MaterialRequest {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description  String
  status       String   @default("pendiente") // pendiente | entregado
  requestedBy  String?
  createdAt    DateTime @default(now())
}

// ---------- Cierre (fase 7 — pendiente de credenciales OK Ticket) ----------

model Invoice {
  id              String        @id @default(cuid())
  projectMemberId String        @unique
  projectMember   ProjectMember @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)
  concept         String
  amount          Int
  state           String        @default("pendiente") // pendiente | recibida
  filePath        String?
  receivedAt      DateTime?
}

model Expense {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source     String   @default("ok_ticket")
  externalId String?
  concept    String
  amount     Int
  syncedAt   DateTime @default(now())
}

// ---------- Protección de datos ----------

/**
 * Registro de accesos a datos personales. El RGPD obliga a poder acreditar
 * quién ha consultado o exportado datos de un tercero y cuándo; sin esta tabla
 * la respuesta a "¿quién sacó el IBAN de fulano?" es "no se sabe".
 *
 * Guarda quién, qué persona, qué hizo y desde dónde. Nunca el dato en sí.
 */
model AccesoDatosPersonales {
  id          String   @id @default(cuid())
  staffUserId String?  // null = acceso del propio interesado por enlace mágico
  staffNombre String   // se guarda el nombre además del id: si la cuenta se borra, el registro debe seguir siendo legible
  personId    String?  // persona cuyos datos se han consultado
  personNombre String?
  accion      String   // ver_ficha | revelar_campo | exportar_altas | editar_datos
  detalle     String?  // p. ej. qué campo se reveló, o el código del proyecto exportado
  ip          String?
  creadoEn    DateTime @default(now())

  @@index([personId, creadoEn])
  @@index([staffUserId, creadoEn])
}

// ---------- Módulo creativo: cerebro de tendencias ----------

/**
 * Una señal captada de una fuente externa.
 *
 * Tabla deliberadamente genérica: un artículo de Dezeen, las visitas diarias de
 * una entrada de Wikipedia y un post de Bluesky son cosas muy distintas, pero
 * para el cerebro son lo mismo — algo que ocurrió, cuándo, con cuánta fuerza.
 * Normalizarlas aquí permite añadir fuentes nuevas sin tocar lo que consume.
 *
 * `crudo` guarda la respuesta original. Ocupa, pero permite reinterpretar el
 * histórico cuando se nos ocurra algo mejor que hacer con él, sin tener que
 * volver a pedir datos que quizá ya no estén disponibles.
 */
model Senal {
  id           String    @id @default(cuid())
  fuente       String    // WIKIPEDIA | GDELT | BLUESKY | HACKERNEWS | RSS
  claveExterna String    // id en el origen: evita duplicar en cada pasada
  titulo       String
  texto        String?   @db.Text
  url          String?
  autor        String?
  idioma       String?
  /// URL directa a la imagen de origen (Telegram, de momento). No se realoja
  /// aquí: si el mensaje se borra en origen, la imagen deja de cargar.
  imagenUrl    String?
  /// Fuerza de la señal en las unidades de su fuente: visitas, puntuación, likes.
  /// No es comparable entre fuentes y no se pretende que lo sea.
  metrica      Float?
  /// Término o cuenta con la que se capturó, para poder agrupar por interés.
  tema         String?
  vertical     String?   // MODA | DISENO | CULTURA | MEME | CINE | TECNOLOGIA | INTERNET
  publicadaEn  DateTime?
  capturadaEn  DateTime  @default(now())
  crudo        Json?

  @@unique([fuente, claveExterna])
  @@index([fuente, publicadaEn])
  @@index([vertical, publicadaEn])
  @@index([tema])
}

/**
 * Qué vigilar. Una sola tabla configura todas las fuentes: un término de
 * Wikipedia, una cuenta de Bluesky, una URL de RSS o una consulta de GDELT.
 *
 * Así ampliar el radar es meter una fila, no desplegar código.
 */
model TemaSeguido {
  id       String  @id @default(cuid())
  fuente   String  // a qué ingestor aplica
  termino  String  // "Streetwear" | "dezeen.com/feed" | "bsky.app"
  etiqueta String? // nombre legible para las pantallas
  vertical String?
  idioma   String? // solo Wikipedia: es, en...
  activo   Boolean @default(true)
  creadoEn DateTime @default(now())

  @@unique([fuente, termino])
  @@index([fuente, activo])
}

/** Registro de cada pasada de ingesta, para saber si el cerebro está vivo. */
model PasadaIngesta {
  id         String   @id @default(cuid())
  fuente     String
  nuevas     Int      @default(0)
  revisadas  Int      @default(0)
  error      String?
  duracionMs Int?
  creadoEn   DateTime @default(now())

  @@index([fuente, creadoEn])
}
